[program:granat-moderation-worker]
process_name=%(program_name)s_%(process_num)02d
command=/usr/bin/php /var/www/granat/artisan queue:work redis --queue=moderation --sleep=3 --tries=3 --timeout=90 --max-time=3600
directory=/var/www/granat
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/www/granat/storage/logs/worker-moderation.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
stopwaitsecs=100
