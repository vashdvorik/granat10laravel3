# =====================================================================================
# BIMM (bimm.md) — рабочий .env с пометками. ЭТО ШПАРГАЛКА ДЛЯ СВЕРКИ, а не файл для подмены.
#
# НЕ копируйте его целиком поверх рабочего файла: значения в <угловых скобках> — это ваши
# пароли и ключи, и они пропадут. Правьте существующий файл построчно.
# Секреты никому не присылайте и не вставляйте в чаты.
#
# Пометки над строками:
#   [ОСТАВИТЬ]  строка верная, ничего не менять
#   [ИЗМЕНИТЬ]  строка есть, значение нужно поправить
#   [ДОБАВИТЬ]  строки на сервере нет, её нужно дописать
#   [УДАЛИТЬ]   код эту переменную больше не читает (список в конце файла)
#
# После правок:  php artisan optimize:clear  и  php artisan queue:restart
# =====================================================================================


# ---------- 1. Приложение ----------

# [ОСТАВИТЬ]
APP_NAME=BIMM
APP_ENV=production
# [ОСТАВИТЬ ВАШ] ключ уже создан. Менять нельзя: перестанет читаться зашифрованное в базе
# (ключ OpenRouter) и все пользователи будут разлогинены.
APP_KEY=<ваш ключ, base64:...>
APP_DEBUG=false
# Именно https: от него зависят ссылки, письма, sitemap.xml и canonical
APP_URL=https://bimm.md

# [ИЗМЕНИТЬ] было LOG_CHANNEL=stack и LOG_LEVEL=debug. Подробный лог на рабочем сайте быстро
# растёт и может хранить лишние данные.
LOG_CHANNEL=daily
LOG_LEVEL=warning


# ---------- 2. База данных ----------

# [ОСТАВИТЬ] значения ваши
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<ваша база>
DB_USERNAME=<ваш пользователь>
DB_PASSWORD=<ваш пароль>


# ---------- 3. Хранилище, кеш, сессии, очередь ----------

# [ОСТАВИТЬ]
FILESYSTEM_DISK=public
CACHE_DRIVER=file
BROADCAST_DRIVER=log
# Очередь в базе: обработчик (Supervisor) ОБЯЗАТЕЛЬНО должен слушать все три очереди:
#   php artisan queue:work --queue=default,moderation,orders
# Без «orders» не уходят Telegram-уведомления, без «moderation» стоит ИИ-проверка.
QUEUE_CONNECTION=database

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=bimm.md
SESSION_SECURE_COOKIE=true


# ---------- 4. Почта ----------
# Без почты нельзя зарегистрироваться: подтверждение приходит письмом.

# [ОСТАВИТЬ]
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<ваш адрес Gmail>
MAIL_PASSWORD=<пароль приложения Gmail>
MAIL_ENCRYPTION=tls
# Этот адрес виден получателям писем и содержит прежнее название. Gmail разрешает отправлять только
# с адреса учётной записи (или её псевдонима), поэтому сменить его можно, заведя новый ящик
# и обновив MAIL_USERNAME и MAIL_PASSWORD.
# Надёжнее Gmail (он блокирует вход с адреса хостинга, ошибка 534-5.7.9) отправлять через SMTP хостинга:
# ящик noreply@bimm.md, MAIL_HOST=mail.bimm.md, MAIL_PORT=465. Пошагово: docs/production_deployment_ru.md, раздел 13.1.
MAIL_FROM_ADDRESS=agenstvogranat@gmail.com
MAIL_FROM_NAME="BIMM ПМР"


# ---------- 5. TELEGRAM-УВЕДОМЛЕНИЯ ПРОДАВЦАМ ----------

# [ДОБАВИТЬ] три строки ниже.
# Токен: в Telegram откройте @BotFather, команда /newbot, придумайте имя и логин бота
# (логин заканчивается на «bot»). BotFather пришлёт токен вида 123456789:AAE...
TELEGRAM_BOT_TOKEN=<токен от @BotFather>
# Логин бота БЕЗ символа @, например bimm_pmr_bot
TELEGRAM_BOT_USERNAME=<логин_бота>
# Секрет вебхука: любая длинная случайная строка из латинских букв, цифр, _ и -.
# Сгенерировать на сервере:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=<результат openssl rand -hex 32>
TELEGRAM_TIMEOUT=10
# Затем зарегистрируйте вебхук (команда в сообщении, где вы получили этот файл) и проверьте getWebhookInfo.


# ---------- 6. ИИ-модерация (только OpenRouter) ----------

# [ОСТАВИТЬ]
PRODUCT_MODERATION_AI_ENABLED=true
# [ИЗМЕНИТЬ] было auto. shadow = ИИ подсказывает, решает человек. На auto переходите
# после проверки модели по docs/moderation_model_selection_ru.md.
PRODUCT_MODERATION_AI_MODE=shadow
# [ОСТАВИТЬ]
PRODUCT_MODERATION_QUEUE=moderation
PRODUCT_MODERATION_TIMEOUT=60
PRODUCT_MODERATION_MAX_ATTEMPTS=3
# [ИЗМЕНИТЬ] было 0.5: ИИ публиковал бы товары при риске до 50%. Для режима auto: 0.05 строго, 0.10 обычно.
PRODUCT_MODERATION_AUTO_APPROVE_MAX_RISK=0.10
# Категории, где ИИ сам не публикует (алиасы через запятую). Пусто = во всех категориях разрешено.
PRODUCT_MODERATION_AUTO_APPROVE_EXCLUDED_CATEGORIES=

# Ключ OpenRouter: введите на странице /admin/moderation-settings (хранится в базе зашифрованным).
# Строку OPENROUTER_API_KEY= в этот файл добавлять не нужно.
# [ОСТАВИТЬ] модели; выбор и проверка — docs/moderation_model_selection_ru.md
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-4o-mini

# [ОСТАВИТЬ]
AI_MODERATION_MAX_OUTPUT_TOKENS=2000
AI_MODERATION_RETRY_TIMES=2
AI_MODERATION_RETRY_SLEEP_MS=1000
AI_MODERATION_REQUESTS_PER_MINUTE=60
AI_MODERATION_RATE_LIMIT_SAFETY_SECONDS=1
# [ИЗМЕНИТЬ] было 6000 в час при 500 в сутки: часовой предел не имел смысла, действовал суточный.
# Лимиты считаются отдельно для текста и для фото. Когда лимит исчерпан, товары идут на ручную проверку.
AI_MODERATION_HOURLY_REQUEST_LIMIT=100
AI_MODERATION_DAILY_REQUEST_LIMIT=1000
# [ОСТАВИТЬ] проверка фото
AI_IMAGE_MODERATION_ENABLED=true
AI_IMAGE_MODERATION_QUEUE=moderation
AI_IMAGE_MODERATION_TIMEOUT=60
AI_IMAGE_MODERATION_MAX_ATTEMPTS=3


# ---------- 7. Сайт ----------

# [ОСТАВИТЬ]
CATEGORIES_HIDE_EMPTY=false
FILAMENT_PANEL_ENABLED=true
FILAMENT_PANEL_PATH=admin
REGIONALITY_ENABLED=true
REGIONAL_URLS_ENABLED=true
REGIONAL_SEO_ENABLED=true

# [ДОБАВИТЬ, необязательно] SEO. Значения по умолчанию подходят для ПМР, строки можно не писать.
# Официальные страницы бренда через запятую: попадут в микроразметку организации.
# SEO_SAME_AS=https://t.me/...,https://www.instagram.com/...

# [УДАЛИТЬ ПУСТЫЕ] ADMIN_EMAIL= и ADMIN_PASSWORD=. Нужны только на момент создания администратора;
# если он уже создан, строки не нужны, пароль в файле держать нельзя.


# ---------- 8. Функции, которых сейчас нет в файле ----------
# [ДОБАВИТЬ, если нужны. Без этих строк функция выключена]

# Вход и регистрация через Google (кнопки появляются, когда заданы ОБА значения)
# GOOGLE_CLIENT_ID=<...>
# GOOGLE_CLIENT_SECRET=<...>

# Пополнение баланса картой (Web-платёж, Агропромбанк). TEST=true — тестовые платежи.
# WEBPAYMENT_ENABLED=true
# WEBPAYMENT_MERCHANT_LOGIN=<...>
# WEBPAYMENT_MERCHANT_PASS=<...>
# WEBPAYMENT_TEST=false

# Капча Cloudflare Turnstile (необязательно)
# TURNSTILE_SITE_KEY=<...>
# TURNSTILE_SECRET_KEY=<...>


# =====================================================================================
# [УДАЛИТЬ] эти строки из рабочего файла (код их больше не читает; остальное — в .env.bak):
#
#   Старые сервисы ИИ:
#     GEMINI_API_KEY, GEMINI_MODEL, GEMINI_BASE_URL, GEMINI_MAX_OUTPUT_TOKENS, GEMINI_RETRY_TIMES,
#     GEMINI_RETRY_SLEEP_MS, GEMINI_REQUESTS_PER_MINUTE, GEMINI_RATE_LIMIT_SAFETY_SECONDS
#     PRODUCT_MODERATION_AI_PROVIDER, PRODUCT_MODERATION_FAKE_DECISION
#     AI_MODERATION_MODEL, AI_MODERATION_BASE_URL, AI_MODERATION_CHAT_COMPLETIONS_PATH,
#     AI_MODERATION_COMPATIBLE_VISION_ENABLED, AI_MODERATION_API_KEY
#     AI_IMAGE_MODERATION_PROVIDER, AI_IMAGE_MODERATION_MODEL, AI_IMAGE_MODERATION_BASE_URL,
#     AI_IMAGE_MODERATION_API_KEY, AI_IMAGE_MODERATION_ENDPOINT_PATH, AI_IMAGE_MODERATION_AUTH_HEADER,
#     AI_IMAGE_MODERATION_AUTH_PREFIX
#     AI_TEXT_GOOGLE_*, AI_TEXT_DEEPSEEK_*, AI_TEXT_OPENAI_COMPATIBLE_*
#     AI_IMAGE_GOOGLE_*, AI_IMAGE_OPENAI_*
#   Неиспользуемое:
#     APP_LOCALE, VITE_* (все), PUSHER_* (все), AWS_* (все), MEMCACHED_HOST, REDIS_* (все, пока кеш,
#     сессии и очередь не на Redis)
#   Комментарии-заголовки «#старое от ИИ модерации» и «#НОВОЕ ИИ МОДЕРАЦИЯ»
#
# Если когда-либо в этих строках стояли настоящие ключи DeepSeek, Gemini, OpenAI, отзовите их у провайдера.
# =====================================================================================
