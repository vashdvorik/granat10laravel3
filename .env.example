APP_NAME=BIMM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=ru

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bimm
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
# ИИ-модерация товаров работает только через OpenRouter (https://openrouter.ai).
# Ключ проще ввести в админке («Система → Настройки модерации»): он хранится в базе зашифрованным.
PRODUCT_MODERATION_AI_ENABLED=false
PRODUCT_MODERATION_AI_MODE=shadow
PRODUCT_MODERATION_QUEUE=moderation
PRODUCT_MODERATION_TIMEOUT=60
PRODUCT_MODERATION_MAX_ATTEMPTS=3
PRODUCT_MODERATION_AUTO_APPROVE_MAX_RISK=0.1
PRODUCT_MODERATION_AUTO_APPROVE_EXCLUDED_CATEGORIES=
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-4o-mini
AI_MODERATION_MAX_OUTPUT_TOKENS=1200
AI_MODERATION_RETRY_TIMES=0
AI_MODERATION_RETRY_SLEEP_MS=500
AI_MODERATION_REQUESTS_PER_MINUTE=5
AI_MODERATION_RATE_LIMIT_SAFETY_SECONDS=1
AI_MODERATION_HOURLY_REQUEST_LIMIT=60
AI_MODERATION_DAILY_REQUEST_LIMIT=500
AI_IMAGE_MODERATION_ENABLED=false
AI_IMAGE_MODERATION_QUEUE=moderation
AI_IMAGE_MODERATION_TIMEOUT=60
AI_IMAGE_MODERATION_MAX_ATTEMPTS=3
SESSION_DOMAIN=null
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="BIMM"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1


CATEGORIES_HIDE_EMPTY=true

FILAMENT_PANEL_ENABLED=true
FILAMENT_PANEL_PATH=admin
REGIONALITY_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
REGIONAL_URLS_ENABLED=true
REGIONAL_SEO_ENABLED=true

# SEO (docs/seo/local_seo_ru.md)
SEO_COUNTRY_CODE=MD
SEO_AREA_NAME=Приднестровье
# Официальные страницы бренда через запятую (Instagram, Telegram, Facebook)
SEO_SAME_AS=
SEO_SITEMAP_CHUNK=40000
SEO_SITEMAP_TTL=900
SEO_STATS_TTL=600

# Приём платежей картой (Web-платёж, Агропромбанк)
WEBPAYMENT_ENABLED=false
WEBPAYMENT_MERCHANT_LOGIN=
WEBPAYMENT_MERCHANT_PASS=
WEBPAYMENT_TEST=true

# Получатель благодарностей «Поблагодарить разработчика» (по умолчанию первый admin)
DEVELOPER_TIP_USER_ID=

# Вход и регистрация одним кликом через Google (кнопки появляются, когда заданы оба ключа).
# Google Cloud Console -> Учётные данные -> OAuth client ID (Web). Redirect URI: https://ВАШ-ДОМЕН/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Защита регистрации и восстановления пароля. Лимиты по IP (значения по умолчанию указаны):
# REGISTER_RATE_PER_MINUTE=5
# REGISTER_RATE_PER_DAY=30
# FORGOT_PASSWORD_RATE_PER_MINUTE=3
# FORGOT_PASSWORD_RATE_PER_DAY=20
# Бесплатная капча Cloudflare Turnstile (необязательно; без ключей не используется):
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
